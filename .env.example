# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=

# Existing PostgreSQL database used by Drizzle; do not commit real connection strings.
DATABASE_URL=
DIRECT_URL=

# Panel administrator credentials; use a password of at least 12 characters.
# Do not reuse database credentials.
PANEL_NAME=
PANEL_PASSWORD=

# HMAC signing key for authenticated sessions (at least 32 characters).
JWT_SECRET=

# Imgbb API key for product image uploads.
IMGBB_API_KEY=4df58c31aabefa92ae9faa7aa0933a67
